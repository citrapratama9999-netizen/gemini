# Copy to .env and change every value before deployment.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Set this to 1 only when served behind HTTPS in production.
COOKIE_SECURE=0
